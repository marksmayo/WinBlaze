<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WinBlaze · Disk analyzer benchmarks</title>
<style>
:root{--bg:#f4f5f7;--ink:#17212c;--muted:#647080;--line:#e3e7ec;--red:#e94636;--blue:#477bd5;--green:#249787;--purple:#8571c3}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 'Segoe UI',system-ui,sans-serif}header{background:#121b27;color:white;padding:24px max(24px,calc((100vw - 1240px)/2));display:flex;justify-content:space-between;align-items:center;gap:16px}.brand{font-weight:850;letter-spacing:3px}.brand i{color:#ff6854;font-style:normal}header a{color:#c9d6e7;text-decoration:none;font-size:13px}main{max-width:1290px;margin:auto;padding:42px 24px 60px}.eyebrow{font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--muted)}h1{font-size:clamp(36px,5vw,64px);line-height:1.06;letter-spacing:-2px;margin:14px 0 20px;max-width:800px}h1 em{font-style:normal;color:var(--red)}.lead{max-width:800px;font-size:18px;color:var(--muted)}.pills{display:flex;flex-wrap:wrap;gap:9px;margin:22px 0}.pill{padding:6px 12px;border:1px solid var(--line);border-radius:30px;background:white;font-size:12px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:28px 0}.card,.panel{background:white;border:1px solid var(--line);border-radius:16px;box-shadow:0 4px 20px #17212c04}.card{padding:22px;border-top:3px solid var(--accent,var(--red))}.number{font-size:38px;line-height:1.3;font-weight:750;letter-spacing:-1px}.card small,.note{color:var(--muted);font-size:12px}.notice{padding:16px 20px;border-left:3px solid #db9a35;background:#fff8e9;border-radius:0 10px 10px 0;color:#735b36;font-size:13px}.grid{display:grid;grid-template-columns:1.5fr 1fr;gap:20px;margin:24px 0}.panel{padding:26px;min-width:0}.panel h2{font-size:20px;margin:0 0 5px;letter-spacing:-.4px}.panel p{margin:5px 0 18px;color:var(--muted);font-size:13px}.controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:18px 0}button{font:inherit;border:1px solid var(--line);border-radius:8px;padding:8px 12px;background:#fafbfc;color:var(--ink)}button{cursor:pointer}button:hover{background:#edf0f5}button:focus-visible,a:focus-visible{outline:3px solid #8dafe8;outline-offset:3px}.chart-row{margin:18px 0}.row-head{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:13px}.row-head strong{font-variant-numeric:tabular-nums}.track{height:32px;background:#f1f3f6;border-radius:6px;margin:7px 0;position:relative}.bar{height:100%;border-radius:6px;width:var(--width);background:var(--color);transition:width .25s}.dot{position:absolute;top:11px;width:10px;height:10px;border-radius:50%;background:white;border:2px solid var(--color);transform:translateX(-50%)}.axis{display:flex;justify-content:space-between;font-size:11px;color:var(--muted)}.legend{display:flex;flex-wrap:wrap;gap:16px;font-size:11px;color:var(--muted);margin:16px 0}.legend span:before{content:'';display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--color);margin-right:6px}.split{display:grid;grid-template-columns:1fr 1fr;gap:20px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;text-align:left;font-size:12px}th{font-weight:600;color:var(--muted);white-space:nowrap}td,th{padding:12px 10px;border-bottom:1px solid var(--line)}td:first-child,th:first-child{padding-left:0}td{font-variant-numeric:tabular-nums}.tag{display:inline-block;font-size:10px;background:#e9f5f1;color:#287864;border-radius:5px;padding:3px 7px}.tag.pending{background:#fff2d9;color:#946928}.version{display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line);padding:16px 0}.version b{display:block}.hash{font:11px ui-monospace,monospace;color:var(--muted);overflow-wrap:anywhere}.version strong{font-size:24px;white-space:nowrap}.findings{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:24px 0}.finding{padding:24px;background:#e9edf2;border-radius:12px}.finding b{display:block;margin-bottom:8px}.finding p{margin:0;color:#536171;font-size:13px}details{margin-top:15px}summary{cursor:pointer;font-weight:650}pre{font:12px/1.6 ui-monospace,monospace;white-space:pre-wrap;background:#121b27;color:#dae4ef;padding:20px;border-radius:10px;overflow-wrap:anywhere}footer{color:var(--muted);font-size:12px;margin-top:28px;display:flex;justify-content:space-between;gap:20px}.wide{margin:24px 0}.excluded{opacity:.55}a{color:var(--blue)}.empty{padding:20px;background:#f6f7f9;border-radius:10px;font-size:13px;color:var(--muted)}@media(max-width:900px){.cards{grid-template-columns:repeat(2,1fr)}.grid,.split{grid-template-columns:1fr}.findings{grid-template-columns:1fr}.panel{padding:20px}}@media(max-width:480px){main{padding:28px 16px}header{padding:20px 16px}.cards{gap:10px}.card{padding:16px}.number{font-size:30px}h1{letter-spacing:-1px}.row-head{font-size:12px}footer{display:block}}@media print{header,button,.controls{display:none}main{max-width:none;padding:0}.panel,.card{break-inside:avoid;box-shadow:none}body{background:white}.bar{print-color-adjust:exact}}
.podium-section{margin:0 0 36px;padding:28px;background:linear-gradient(135deg,#fff,#f9fafc);border:1px solid var(--line);border-radius:20px}.podium-section h2{font-size:26px;margin:6px 0}.podium-section p{color:var(--muted);font-size:13px;margin:5px 0}.podium{display:grid;grid-template-columns:repeat(3,1fr);align-items:end;gap:16px;margin:30px auto 18px;max-width:880px}.podium-app{text-align:center;min-width:0}.podium-app h3{font-size:22px;margin:12px 0 4px}.medal-emblem{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;margin:auto;font-size:26px;font-weight:800;color:var(--medal-ink);background:linear-gradient(145deg,var(--medal-light),var(--medal));border:3px double var(--medal-ink);box-shadow:0 6px 14px #17212c15}.medal-counts{display:flex;justify-content:center;gap:10px;margin:12px 0 18px;font-size:13px}.medal-counts span{padding:4px 8px;border-radius:20px;background:white;border:1px solid var(--line);white-space:nowrap}.pedestal{height:var(--height);box-sizing:border-box;overflow:hidden;padding:0 10px;border-radius:12px 12px 0 0;background:linear-gradient(160deg,var(--medal-light),var(--medal));color:var(--medal-ink);border:none;display:flex;flex-direction:column;justify-content:center}.pedestal strong{font-size:56px;line-height:1.1}.pedestal small{font-size:11px;text-transform:uppercase;letter-spacing:2px;font-weight:700}.podium-rule{font-size:12px;color:var(--muted)}@media(max-width:600px){.podium-section{padding:18px 12px}.podium{gap:8px}.podium-app h3{font-size:15px}.medal-counts{gap:4px;flex-direction:column;align-items:center;font-size:11px}.medal-emblem{width:44px;height:44px;font-size:21px}.pedestal strong{font-size:40px}}
.medal-comparison{min-width:760px;table-layout:fixed}.medal-comparison caption{text-align:left;color:var(--muted);padding:14px 0;font-size:12px}.medal-comparison th:first-child{width:43%}.medal-comparison th,.medal-comparison td{padding:14px 12px;vertical-align:top;white-space:normal}.medal-comparison thead th{position:sticky;top:0;background:#edf1f5;z-index:2;color:var(--ink);font-size:14px}.medal-comparison tbody th{font-weight:400;color:var(--ink)}.medal-comparison tbody tr:nth-child(even){background:#f5f7fa}.medal-value{display:block;font-size:16px;white-space:nowrap}.medal-badge{display:block;width:fit-content;padding:3px 8px;border-radius:6px;margin:6px 0;font-size:12px;font-weight:650}.medal-badge.gold{background:#fff1c2;color:#765400}.medal-badge.silver{background:#e7edf4;color:#455466}.medal-badge.bronze{background:#f6e3d4;color:#875225}.medal-badge.unranked{color:var(--muted)}.medal-scroll{max-height:75vh;margin-top:14px;border:1px solid var(--line);border-radius:10px}.medal-scroll:focus-visible{outline:3px solid #8dafe8}@media print{.medal-scroll{max-height:none;overflow:visible}.medal-comparison{min-width:0}.podium-section{break-inside:auto}.medal-comparison tr{break-inside:avoid}}
</style></head><body>
<header><div class="brand">WIN<i>BLAZE</i> <span style="font-weight:400;font-size:11px;letter-spacing:1px;margin-left:12px">PERFORMANCE LAB</span></div><a href="#medal-title">Compare the results ↘</a></header>
<main><section class="podium-section" aria-labelledby="medal-title"><div class="eyebrow">The medal table</div><h2 id="medal-title">Three apps. One podium.</h2><p>Performance: lowest result gets gold, second silver, third bronze. Features: full support gets gold, partial silver, none bronze. Ranked by gold count, then silver, then bronze.</p><div id="podium"></div><div id="medal-events"></div></section><div class="eyebrow">Current comparison / Windows · NTFS</div><h1>Every file.<br>Every millisecond <em>counts.</em></h1><p class="lead">A measured look at WinBlaze, WinDirStat, and WizTree: scan time, startup, resource use, correctness, and the cost of turning a disk into a useful view.</p>
<div class="pills"><span class="pill">Release · Rust 1.96.0</span><span class="pill">20 logical processors</span><span class="pill">Live C: volume</span><span class="pill">10 runs per workload</span><span class="pill">Self-contained · works offline</span></div><section class="panel wide"><div class="eyebrow">Automated comparison / common workflow</div><h2>Startup → scan → CSV export</h2><p class="notice">WinDirStat and WizTree: official values retain the best validated ten-run statistic for each metric and software version. Slower batches never replace a record. WinBlaze uses its latest validated result per metric. All 35 rows remain visible while refreshes are pending. Each metric can select a different dated batch; the record source appears beside its medal value. Latest raw observations remain available separately.</p><div id="batch-status"></div><div id="workflow-chart"></div><div id="workflow-stats"></div><p class="note">All three execute a complete scan/export process. WinBlaze includes native indexing/persistence; scanner policies and file totals can still differ. GUI and engine phases have separate measurement boundaries.</p></section>
<div class="cards" id="cards"></div><div class="notice"><b>Read the scope before comparing.</b> Headline timings, scan charts, CPU/memory charts and standard-user scan medals use startup + scan + CSV export for all three products. WinBlaze includes indexing and persistence. Caches are uncontrolled, measurement dates and accessible-file counts differ. GUI and engine phases use separate measurement boundaries.</div>
<div class="grid"><section class="panel"><div class="eyebrow">01 / Scan workflows</div><h2>Time to analyze · full C:</h2><p>Bars show medians. Dots show individual accepted runs. Lower is faster within the same measurement scope. Competitor bars use retained version-specific best batches; WinBlaze uses current measurements.</p><div class="controls"><input type="hidden" id="profile" value="full"><input id="warm" type="checkbox" hidden></div><div id="scan-chart"></div><div class="axis"><span>0</span><span id="scan-max"></span></div><div class="legend"><span style="--color:var(--red)">WinBlaze export</span><span style="--color:var(--blue)">WinDirStat export</span><span style="--color:var(--green)">WizTree export</span></div><div class="note" id="dataset-note"></div></section>
<section class="panel"><div class="eyebrow">02 / Initialization</div><h2>Startup, carefully defined</h2><p>Launch request to first idle GUI message queue. Hidden-window proxy; does not measure a visible, usable window.</p><div id="startup-chart"></div><div id="startup-optimization"></div><div class="notice" id="cache-summary" style="margin-top:25px"></div></section></div>
<div class="split"><section class="panel"><div class="eyebrow">03 / Resource footprint</div><h2>Memory & CPU</h2><p>Full C: startup + scan + CSV export. This graph shows peak working set; the comparison table above includes CPU and private memory for every eligible dataset. CPU-seconds sum activity across cores.</p><div class="controls"><input type="hidden" id="resource" value="memory"></div><div id="resource-chart"></div><p class="note">Sampling can miss brief peaks. Short-lived engine runs without samples are missing values, never zero usage.</p></section>
<section class="panel"><div class="eyebrow">04 / Binary provenance</div><h2>Know exactly what ran</h2><p>Executable versions and SHA-256 identities are captured by the runners. A changed binary starts a separate version-history entry.</p><div id="versions"></div><details><summary>Version observation history</summary><div class="table-wrap"><table><thead><tr><th>Tool</th><th>Version</th><th>First observed UTC</th></tr></thead><tbody id="version-history"></tbody></table></div></details></section></div>
<section class="panel wide"><div class="eyebrow">Additional performance medals</div><h2>Slow runs & consistency</h2><p>This graph shows full C: 90th percentile completion for the same startup + scan + CSV export boundary. All datasets and timing variability appear in the comparison table above. At least ten accepted runs per product. A lower spread means more consistent results; it does not mean a faster scan.</p><div class="controls"><input type="hidden" id="distribution-metric" value="90th percentile completion"></div><div id="distribution-chart"></div><p class="note">P90 uses linear interpolation (R-7). These small-sample tail estimates are affected by uncontrolled caches and live-volume changes. Related medal events each carry equal weight; the podium is a scorecard, not a universal product ranking.</p><details><summary>Metrics still awaiting comparable measurements</summary><p>Visible-ready startup, cache reopen, incremental updates, input latency, duplicate detection and feature-specific operations need equivalent measurements from all three products. File throughput and CPU per file are omitted as extra medals because on equal-size fixtures they duplicate elapsed/CPU rankings; live-volume file counts differ. CSV size is not a medal: schemas and content differ. Process I/O, handles and thread counts need explicit instrumentation and sampling validation.</p></details></section>
<section class="panel wide"><div class="eyebrow">05 / Administrator-token comparison</div><h2>The NTFS fast path</h2><p>Elevated competitor exports are compared separately. WinBlaze phase decomposition isolates raw MFT streaming; it excludes catalog indexing and rendering.</p><div id="elevated"></div></section>
<div class="findings"><article class="finding"><div class="eyebrow">Correctness</div><b>Counts agree on synthetic folders.</b><p>Quick, empty-file scale, and nonempty dense workloads match file and logical-byte totals. Competitor folder counts exclude the root; WinBlaze counts include it.</p></article><article class="finding"><div class="eyebrow">Allocation</div><b>Allocation comes from Windows.</b><p>Directory scans now query actual allocated storage and count hard-linked storage once while retaining every logical file name. Resident NTFS files may allocate no clusters. Access failures are reported rather than replaced with logical-size estimates.</p></article><article class="finding"><div class="eyebrow">Responsiveness</div><b>Measure the whole interaction.</b><p>Earlier session-wide WinBlaze counters reached 101 ms peak flush and 568 ms peak frame interval. These span multiple activities and do not isolate input latency during a scan.</p></article></div>
<section class="panel wide" id="feature-performance"><div class="eyebrow">08 / Feature workloads</div><h2>What does each feature cost?</h2><p>Ten repeats by default. Only validated outputs enter medians. Whole-process time includes startup and all work described by the scope; CPU and memory are sampled lower bounds. Different feature scopes are not equivalent benchmarks. All workloads and measured values are listed in the table below; the graph illustrates content duplicate detection.</p><div class="controls"><input type="hidden" id="feature-operation" value="content-duplicates"><input type="hidden" id="feature-metric" value="elapsed_ms"></div><div id="feature-medal-status"></div><div id="feature-performance-chart"></div><details><summary>Medal eligibility · every workload × metric</summary><div id="feature-medal-matrix"></div></details><div id="feature-performance-results"></div><details><summary>Performance coverage for every feature</summary><div id="feature-performance-coverage"></div></details></section>
<footer><span>WinBlaze Performance Lab · Evidence over assumptions</span><span id="generated"></span></footer>
</main>
<script>
const DATA = /* BENCHMARK_DATA */;
const $ = id => document.getElementById(id);
const colors = ['#e94636','#8571c3','#477bd5','#249787'];
const median = values => { const a=values.filter(Number.isFinite).sort((a,b)=>a-b); return a.length ? (a[Math.floor((a.length-1)/2)]+a[Math.floor(a.length/2)])/2 : null; };
const time = n => n==null?'Not measured':n>0&&n<0.001?'<0.001 ms':n>=1000?(n/1000).toFixed(2)+' s':(n>0&&n<1?n.toFixed(3):Math.round(n))+' ms';
const num = n => n==null?'—':Math.round(n).toLocaleString();
const escape = s => String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const accepted = rows => rows.filter(r=>r.included_in_summary!==false&&r.baseline_current!==false);
$('batch-status').textContent=DATA.batch.batch_id?`Batch ${DATA.batch.batch_id} · ${DATA.batch.state} · requested n=${DATA.batch.requested_runs} · ${DATA.batch.elevation}${DATA.batch.error?' · '+DATA.batch.error:''}`:'No automated batch yet. Run benchmarks/run-comparison.ps1 to collect n=10 scan/export results.';
const featureBadge=level=>({full:'🥇 Full',partial:'🥈 Partial',none:'🥉 None',unknown:'Unverified'}[level]||'Unverified')+'<br>';

const restored=(DATA.cache||[]).filter(r=>r.baseline_current!==false&&Number.isFinite(r.native_decode_ms));
$('cache-summary').innerHTML=restored.length?`WinBlaze cache decode median: <b>${time(median(restored.map(r=>r.native_decode_ms)))}</b> across ${restored.length} runs (${escape(restored[0].cache_bytes_label||'size unavailable')}; ${num(restored[0].entries)} entries). Decode timing excludes total launch-to-ready work.`:'No current-build cache measurements yet.';
const medalStyles=[{medal:'#efd17b',light:'#fff5ce',ink:'#876218'},{medal:'#c4cfdb',light:'#eff3f8',ink:'#536579'},{medal:'#d5ad91',light:'#fae8dc',ink:'#855332'}];
function podiumHeight(place){return [240,180,125][place-1]||125;}

const podiumOrder=[DATA.medals.standings[1],DATA.medals.standings[0],DATA.medals.standings[2]];
$('podium').innerHTML='<div class="podium">'+podiumOrder.map(row=>{const s=medalStyles[row.place-1]||medalStyles[2];return `<article class="podium-app" style="--medal:${s.medal};--medal-light:${s.light};--medal-ink:${s.ink};--height:${podiumHeight(row.place)}px" aria-label="${escape(row.tool)}, rank ${row.place}, ${row.gold} gold, ${row.silver} silver, ${row.bronze} bronze"><div class="medal-emblem" aria-hidden="true">${row.place}</div><h3>${escape(row.tool)}</h3><div class="medal-counts"><span>🥇 ${row.gold}</span><span>🥈 ${row.silver}</span><span>🥉 ${row.bronze}</span></div><div class="pedestal"><strong>${row.place}</strong><small>Place</small></div></article>`}).join('')+'</div>';
const medalSymbols={gold:'🥇',silver:'🥈',bronze:'🥉'};
const bestSource=(event,tool)=>{const best=event.competitor_bests?.[tool];const prior=event.result_sources?.[tool];if(event.pending_refresh?.[tool])return `<div class="note">Awaiting validated refresh � previous result � ${escape(prior?.source||best?.source||'prior batch')} � ${escape(prior?.identity?.sha256?.slice(0,12)||best?.identity?.sha256?.slice(0,12)||'')}</div>`;return best?`<div class="note">Retained best · ${escape(best.source)} · ${escape(best.identity.product_version||best.identity.file_version||'version unavailable')}</div>`:'';};
const medalValue=event=>value=>event.category==='feature'?({full:'Full · 3/3',partial:'Partial · 2/3',none:'None · 1/3',unverified:'Not verified'}[value]||'Not verified'):event.unit==='ms'?time(value):Number.isFinite(value)?value.toFixed(2)+' '+event.unit:'Not measured';
$('medal-events').innerHTML=`<h3>Every medal, side by side</h3><p class="podium-rule"><b>${DATA.medals.events.length} medal events.</b> Sorted by WinBlaze / best competitor, highest ratio first: 4× is a larger gap than 3×; below 1× means WinBlaze uses less time or resource than either competitor. Values are medians unless the row names another statistic. Feature support scores: full 3/3 (gold), partial 2/3 (silver), none 1/3 (bronze). Equal support, WinBlaze advantages over both competitors, and features where WinBlaze shares gold with either competitor are excluded. Unverified support earns no medal. Exact ties share medals. Each event contributes once to the podium. Mixed scopes remain observational; the podium is a scorecard, not a controlled overall ranking.</p><div class="table-wrap medal-scroll" tabindex="0" role="region" aria-label="All medal measurements compared by product"><table class="medal-comparison"><caption>Measurement values and medals, ordered from largest relative gap to strongest WinBlaze advantage</caption><thead><tr><th scope="col">Measurement / scope</th>${['WinBlaze','WinDirStat','WizTree'].map(tool=>'<th scope="col">'+tool+'</th>').join('')}</tr></thead><tbody>${DATA.medals.events.map((event,index)=>`<tr data-medal-event="${index}"><th scope="row"><b>${escape(event.name)}</b><div class="note"><strong>${escape(event.relative_label)}</strong></div><span class="tag ${event.category==='feature'||event.comparable?'':'pending'}">${event.category==='feature'?'Feature support':event.comparable?'Same protocol':'Mixed scope'}</span><div class="note">${escape(event.scope)}</div></th>${['WinBlaze','WinDirStat','WizTree'].map(tool=>{const award=event.awards.find(a=>a.tool===tool);const value=event.category==='feature'?event.support[tool]:event.times[tool];return `<td data-tool="${tool}" data-medal="${award?.medal||'none'}"><strong class="medal-value">${escape(medalValue(event)(value))}</strong>${bestSource(event,tool)}<span class="medal-badge ${award?.medal||'unranked'}">${award?medalSymbols[award.medal]+' '+award.medal[0].toUpperCase()+award.medal.slice(1):'No medal'}</span>${event.category==='feature'?'':'<span class="note">n='+event.samples[tool]+'</span>'}</td>`;}).join('')}</tr>`).join('')}</tbody></table></div><details><summary>Excluded measurements and reasons</summary>${DATA.medals.exclusions.map(e=>`<p><b>${escape(e.name)}:</b> ${escape(e.reason)}</p>`).join('')}</details>`;
const readyRows=accepted(DATA.uiReady||[]);
const readyMetric=(key,divisor,unit)=>{const value=median(readyRows.map(r=>r[key]).filter(Number.isFinite));return value==null?'—':(value/divisor).toFixed(2)+' '+unit;};
const readyCurrent='<h3>Current release · visible-ready startup</h3><p>Fresh empty catalog, visible maximized window and enabled scan controls; includes accessibility polling, excludes restored catalogs. Validated n='+readyRows.length+'.</p><div class="table-wrap"><table><thead><tr><th>Ready time</th><th>CPU through readiness</th><th>Working set at readiness</th></tr></thead><tbody><tr><td>'+time(median(readyRows.map(r=>r.ready_ms)))+'</td><td>'+readyMetric('cpu_ms',1000,'CPU-s')+'</td><td>'+readyMetric('working_set_bytes',1048576,'MiB')+'</td></tr></tbody></table></div>';

$('startup-optimization').innerHTML=readyCurrent;
const guiProfile = r => r.profile || r.scenario.replace(/-\d+$/,'');
const profileLabels={tiny:'Quick folder',scale:'Empty-file scale','fanout-large':'Nonempty dense folder',full:'Full C: volume'};
function officialValues(eventName,tool,fallback){return DATA.medals.events.find(e=>e.name===eventName)?.measurements?.[tool]||fallback;}
function officialValue(eventName,tool,fallback){return DATA.medals.events.find(e=>e.name===eventName)?.times?.[tool]??fallback;}
function chart(id,groups,format=time){const max=Math.max(1,...groups.flatMap(g=>g.values));$(id).innerHTML=groups.map((g,i)=>{const m=median(g.values);return `<div class="chart-row"><div class="row-head"><span>${escape(g.name)}</span><strong>${format(m)}</strong></div><div class="track" style="--color:${g.color||colors[i%4]}"><div class="bar" style="--width:${m==null?0:m/max*100}%"></div>${g.values.map((v,j)=>`<span class="dot" tabindex="0" role="img" aria-label="Observation ${j+1}: ${format(v)}" title="Observation ${j+1}: ${format(v)}" style="left:${v/max*100}%"></span>`).join('')}</div><div class="note">${escape(g.scope)} · n=${g.values.length}</div></div>`}).join('');return max;}
function scans(){const p=$('profile').value;const warm=$('warm').checked;const groups=['WinBlaze','WinDirStat','WizTree'].map((name,i)=>{let rows=accepted(DATA.workflow).filter(r=>r.profile===p&&r.tool===name);if(warm)rows=rows.slice(1);return {name,color:colors[[0,2,3][i]],scope:'Startup + scan + CSV export',values:officialValues(profileLabels[p]+' · scan workflow',name,rows.map(r=>r.elapsed_ms))};});$('scan-max').textContent=time(chart('scan-chart',groups));$('dataset-note').textContent='Same process boundaries for all three products. Live-volume contents, accessible-file counts and scanner policies can differ; see the workflow table.';}
function workflow(){const profile=$('profile').value;const groups=['WinBlaze','WinDirStat','WizTree'].map((tool,i)=>({name:tool,color:colors[[0,2,3][i]],scope:`${profile} · whole scan/export process`,values:officialValues(profileLabels[profile]+' · scan workflow',tool,accepted(DATA.workflow).filter(r=>r.tool===tool&&r.profile===profile).map(r=>r.elapsed_ms))}));chart('workflow-chart',groups);$('workflow-stats').innerHTML='<p class="note">Latest batch raw observations. Official retained competitor bests appear in the graphs and medal table; different metrics may use different batches.</p><div class="table-wrap"><table><thead><tr><th>Product</th><th>n</th><th>Latest median</th><th>Latest min – max</th><th>Files range</th></tr></thead><tbody>'+groups.map(g=>{const rows=accepted(DATA.workflow).filter(r=>r.tool===g.name&&r.profile===profile);return `<tr><td>${g.name}</td><td>${rows.length}</td><td>${time(median(rows.map(r=>r.elapsed_ms)))}</td><td>${g.values.length?time(Math.min(...rows.map(r=>r.elapsed_ms)))+' – '+time(Math.max(...rows.map(r=>r.elapsed_ms))):'—'}</td><td>${rows.length?num(Math.min(...rows.map(r=>r.files)))+' – '+num(Math.max(...rows.map(r=>r.files))):'—'}</td></tr>`}).join('')+'</tbody></table></div>';}
const guiFull=accepted(DATA.gui).filter(r=>guiProfile(r)==='full');
const cardData=['WinBlaze','WinDirStat','WizTree'].map((name,i)=>[name,officialValue('Full C: volume · scan workflow',name,median(accepted(DATA.workflow).filter(r=>r.profile==='full'&&r.tool===name).map(r=>r.elapsed_ms))),'Startup + scan + CSV export',colors[[0,2,3][i]]]);
$('cards').innerHTML=cardData.map(([name,value,scope,color])=>`<div class="card" style="--accent:${color}"><div class="eyebrow">${name}</div><div class="number">${time(value)}</div><small>${scope}</small></div>`).join('');
chart('startup-chart',['WinBlaze','WinDirStat','WizTree'].map((name,i)=>({name,scope:'First idle message queue',color:colors[[0,2,3][i]],values:officialValues('Startup · first idle message queue',name,DATA.startup.filter(r=>r.tool===name&&r.idle_reached&&r.baseline_current!==false).map(r=>r.initialization_ms))})));
function resources(){const metric=$('resource').value;const mem=metric!=='cpu';const key=metric==='private'?'peak_private_bytes_sampled':mem?'peak_working_set_bytes_sampled':'cpu_ms_sampled_lower_bound';const div=mem?1048576:1000;chart('resource-chart',['WinBlaze','WinDirStat','WizTree'].map((name,i)=>({name,color:colors[[0,2,3][i]],scope:'Startup + scan + CSV export',values:officialValues($('profile').value==='full'?'Standard-user · full-drive '+(metric==='private'?'private memory':mem?'peak memory':'CPU consumption'):profileLabels[$('profile').value]+' · '+(metric==='private'?'private memory':mem?'peak memory':'CPU consumption'),name,accepted(DATA.workflow).filter(r=>r.profile===$('profile').value&&r.tool===name&&r[key]!=null).map(r=>r[key]/div))})),n=>n==null?'Not measured':n.toFixed(1)+(mem?' MiB':' CPU-s'));}
function distributions(){
 const labels={tiny:'Quick folder',scale:'Empty-file scale','fanout-large':'Nonempty dense folder',full:'Full C: volume'};
 const label=labels[$('profile').value];const metric=$('distribution-metric').value||'90th percentile completion';
 const event=DATA.medals.events.find(e=>e.name===label+' · '+metric);
 if(!event){$('distribution-chart').innerHTML='<div class="empty">At least ten valid common-workflow observations per product are required.</div>';return;}
 const maximum=Math.max(1,...event.awards.map(a=>a.ms));const format=value=>event.unit==='ms'?time(value):value.toFixed(2)+'%';
 $('distribution-chart').innerHTML=['WinBlaze','WinDirStat','WizTree'].map((tool,i)=>{const award=event.awards.find(a=>a.tool===tool);return `<div class="chart-row"><div class="row-head"><span>${tool} · ${award.medal}</span><strong>${format(award.ms)}</strong></div><div class="track"><div class="bar" style="--width:${award.ms/maximum*100}%;background:${colors[[0,2,3][i]]}"></div></div><div class="note">${escape(label)} · accepted n=${event.samples[tool]}</div></div>`;}).join('');
}
function featurePerformance(){
    const rows=DATA.featurePerformance||[];
    const eligible=accepted(rows).filter(r=>r.status==='measured'&&r.validation?.verified===true);
    const operation=$('feature-operation').value||'content-duplicates';
    const key=$('feature-metric').value||'elapsed_ms';
    const phase=key==='load_ms'||key==='operation_ms';
    const value=(r,k)=>k==='operation_ms'&&r.operation==='cache-load'?null:(k==='load_ms'||k==='operation_ms'?r.validation?.[k]:r[k]);
    const bytes=key.includes('bytes'), cpu=key.startsWith('cpu_');
    const divisor=bytes?1048576:cpu?1000:1;
    const format=bytes?(v=>v==null?'Not measured':v.toFixed(2)+' MiB'):cpu?(v=>v==null?'Not measured':v.toFixed(2)+' CPU-s'):phase?(v=>v==null?'Not measured':v.toFixed(2)+' ms'):time;
    const jobs=[...new Set(rows.filter(r=>r.operation===operation).map(r=>r.job))];
    if(!jobs.length){$('feature-performance-chart').innerHTML='<div class="empty">No measurements yet. Run benchmarks/run-feature-comparison.ps1.</div>';}else{
        chart('feature-performance-chart',jobs.map(job=>{const all=rows.filter(r=>r.job===job);return {name:all[0].tool,scope:all[0].scope,values:eligible.filter(r=>r.job===job&&value(r,key)!=null).map(r=>value(r,key)/divisor)}}),format);
    }
    const selected=DATA.featureMedalCoverage.find(r=>r.operation===operation&&r.metric===key);
    $('feature-medal-status').innerHTML='<p><b>'+escape(selected?.reason||'No comparable measurements recorded.')+'</b>'+ (selected?.awards.length?'<br>'+selected.awards.map(a=>({gold:'🥇',silver:'🥈',bronze:'🥉'}[a.medal])+' '+escape(a.tool)).join(' · '):'')+'</p>';
    $('feature-medal-matrix').innerHTML='<div class="table-wrap"><table><thead><tr><th>Workload</th><th>Metric</th><th>Validated runs · WB / WDS / Wiz</th><th>Medals / reason</th></tr></thead><tbody>'+DATA.featureMedalCoverage.map(r=>`<tr><td>${escape(r.operation)}</td><td>${escape(r.metric)}</td><td>${r.counts.WinBlaze} / ${r.counts.WinDirStat} / ${r.counts.WizTree}</td><td>${r.awards.map(a=>({gold:'🥇',silver:'🥈',bronze:'🥉'}[a.medal])+' '+escape(a.tool)).join(' · ')}<br>${escape(r.reason)}</td></tr>`).join('')+'</tbody></table></div>';
    const allJobs=[...new Set(rows.map(r=>r.job))];
    $('feature-performance-results').innerHTML='<div class="table-wrap"><table><thead><tr><th>Product / workload / scope</th><th>Validated n</th><th>Process median</th><th>CPU median</th><th>Peak WS median</th><th>Private median</th><th>Output median</th><th>Native phases</th><th>Status / checks</th></tr></thead><tbody>'+allJobs.map(job=>{
        const all=rows.filter(r=>r.job===job), good=eligible.filter(r=>r.job===job), first=all[0];
        const metric=key=>median(good.filter(r=>value(r,key)!=null).map(r=>value(r,key)));
        const fmt=(value,divisor,unit)=>value==null?'—':(value/divisor).toFixed(2)+' '+unit;
        const failures=all.filter(r=>r.status!=='measured').map(r=>r.status+': '+(r.note||'')).join('; ');
        const detail=first.validation?Object.entries(first.validation).filter(([k])=>!['verified','load_ms','operation_ms'].includes(k)).map(([k,v])=>k+': '+v).join('; '):'';
        return `<tr><td><b>${escape(first.tool)} · ${escape(first.operation)}</b><br>${escape(first.scope)}</td><td>${good.length}/${first.requested_runs||10}</td><td>${time(metric('elapsed_ms'))}</td><td>${fmt(metric('cpu_ms_sampled_lower_bound'),1000,'CPU-s')}</td><td>${fmt(metric('peak_working_set_bytes_sampled'),1048576,'MiB')}</td><td>${fmt(metric('peak_private_bytes_sampled'),1048576,'MiB')}</td><td>${fmt(metric('output_bytes'),1048576,'MiB')}</td><td>Load ${fmt(metric('load_ms'),1,'ms')}<br>Operation ${fmt(metric('operation_ms'),1,'ms')}</td><td>${escape(failures||'Validated outputs')}<br>${escape(detail)}</td></tr>`;
    }).join('')+'</tbody></table></div>';
    $('feature-performance-coverage').innerHTML='<div class="table-wrap"><table><thead><tr><th>Feature</th><th>Automated jobs / status</th><th>Coverage and limits</th></tr></thead><tbody>'+DATA.features.rows.map(feature=>`<tr><td>${escape(feature.feature)}</td><td>${(feature.performance?.jobs||[]).map(job=>{const matches=rows.filter(r=>r.job===job);const n=eligible.filter(r=>r.job===job).length;return escape(job)+': '+(n?n+' validated':escape(matches[0]?.status||'Not run'))}).join('<br>')||'Existing measurements / GUI adapter needed'}</td><td>${escape(feature.performance?.coverage||'Coverage not recorded')}</td></tr>`).join('')+'</tbody></table></div>';
}
featurePerformance();
$('feature-operation').addEventListener('change',featurePerformance);
$('feature-metric').addEventListener('change',featurePerformance);
const initial=[{tool:'WinBlaze',version:'0.9.1 · '+(DATA.built[0]?.revision||'').slice(0,7),sha256:(DATA.versions.filter(r=>r.tool==='WinBlaze').at(-1)||DATA.built[0])?.sha256},...['WinDirStat','WizTree'].map(tool=>{const inv=DATA.versions.filter(r=>r.tool===tool).at(-1)||DATA.inventory.find(r=>r.path?.includes(tool));return {tool,version:inv?.product_version||inv?.version,sha256:inv?.sha256}})];
$('versions').innerHTML=initial.map(r=>`<div class="version"><div><b>${r.tool}</b><span class="hash">SHA-256 ${escape(r.sha256?.slice(0,20))}…</span></div><strong>${escape(r.version)}</strong></div>`).join('');
$('version-history').innerHTML=DATA.versions.map(r=>`<tr><td>${escape(r.tool)}</td><td>${escape(r.product_version||r.revision?.slice(0,7)||'unversioned')}</td><td>${escape(r.observed_utc)}</td></tr>`).join('');
const elevatedGroups=['WinDirStat','WizTree'].map((name,i)=>({name,scope:'Administrator token · startup + scan + export',color:colors[i+2],values:officialValues('Administrator · full-drive workflow',name,DATA.elevated.filter(r=>r.tool===name).map(r=>r.elapsed_ms))}));
if(DATA.elevated.length){chart('elevated',elevatedGroups);}
else $('elevated').innerHTML=`<div class="empty">${escape(DATA.elevatedStatus.detail||'Elevated measurements not yet available.')} Status: ${escape(DATA.elevatedStatus.state||'not measured')}.</div>`;
if(accepted(DATA.mft).length){$('elevated').insertAdjacentHTML('beforeend','<div class="notice" style="margin-top:20px">WinBlaze raw MFT streaming median: <b>'+time(median(accepted(DATA.mft).map(r=>r.phases.full_ms)))+'</b>. This excludes indexing and UI work. Phase totals are not additive: the harness repeats reads and parsing in separate experiments.</div><details><summary>Raw WinBlaze MFT phase measurements</summary><pre>'+escape(JSON.stringify(accepted(DATA.mft).map(({run,process_ms,phases})=>({run,process_ms,phases})),null,2))+'</pre></details>');}
if(accepted(DATA.native||[]).length){$('elevated').insertAdjacentHTML('beforeend','<div id="native-chart"></div>');chart('native-chart',[{name:'WinBlaze · scan + index publication',color:colors[0],scope:'Administrator token · scan through Completed callback; index publication included; deferred cache write and UI/export excluded',values:accepted(DATA.native).map(r=>r.scan_ms)},{name:'WinBlaze · whole native process',color:colors[1],scope:'Includes deferred snapshot write and tree queries; excludes GUI/CSV export',values:accepted(DATA.native).map(r=>r.process_ms)}]);}
const historicalNative=(DATA.native||[]).filter(r=>r.baseline_current===false&&r.historical_eligible);
if(historicalNative.length&&!accepted(DATA.native||[]).length){
    $('elevated').insertAdjacentHTML('beforeend','<details style="margin-top:20px"><summary>Historical administrator measurements · rebuilt binary rerun pending</summary><p class="note">These '+historicalNative.length+' validated runs used the prior binary. They remain available as historical evidence and are excluded from current medians and medals.</p><h3>Whole-process elevated resource use · historical binary</h3><div class="table-wrap"><table><thead><tr><th>Scope</th><th>Runs</th><th>Time</th><th>Sampled CPU</th><th>Sampled peak working set</th></tr></thead><tbody><tr><td>WinBlaze · whole native process<br><span class="note">Includes deferred snapshot write and tree queries; no GUI/CSV</span></td><td>'+historicalNative.length+'</td><td>'+time(median(historicalNative.map(r=>r.process_ms)))+'</td><td>'+num(median(historicalNative.map(r=>r.cpu_ms_sampled_lower_bound))/1000)+' CPU-s</td><td>'+num(median(historicalNative.map(r=>r.peak_working_set_bytes_sampled))/1048576)+' MiB</td></tr></tbody></table></div></details>');
}
const elevatedResources=[['MFT phase experiments',accepted(DATA.mft||[])],['Native whole process including deferred cache write',accepted(DATA.native||[])]];
if(elevatedResources.some(([,rows])=>rows.length)) $('elevated').insertAdjacentHTML('beforeend','<h3>Whole-process elevated resource use</h3><p class="note">Separate scopes: phase resources include repeated read/parse experiments; native resources include the complete process and deferred cache write. CPU values are sampled lower bounds.</p><div class="table-wrap"><table><thead><tr><th>Workflow</th><th>Runs</th><th>Sampled CPU</th><th>Sampled peak working set</th></tr></thead><tbody>'+elevatedResources.map(([name,rows])=>{const cpu=rows.map(r=>r.cpu_ms_sampled_lower_bound).filter(n=>Number.isFinite(n)&&n>0),memory=rows.map(r=>r.peak_working_set_bytes_sampled).filter(n=>Number.isFinite(n)&&n>0);return `<tr><td>${escape(name)}</td><td>${rows.length}</td><td>${cpu.length?(median(cpu)/1000).toFixed(2)+' CPU-s':'Not sampled'}</td><td>${memory.length?(median(memory)/1048576).toFixed(1)+' MiB':'Not sampled'}</td></tr>`}).join('')+'</tbody></table></div>');

$('profile').addEventListener('change',()=>{scans();workflow();resources();distributions();});$('distribution-metric').addEventListener('change',distributions);$('warm').addEventListener('change',()=>{scans();workflow();});$('resource').addEventListener('change',resources);$('generated').textContent='Report generated '+new Date(DATA.generated).toLocaleString();scans();workflow();resources();distributions();
</script></body></html>
